# Portainer: Werte unter Environment variables eintragen.
# Bei lokalem Docker Compose alternativ als .env speichern.
# Geheimnisse niemals committen.
PIHOLE_URL=http://192.168.178.1
PIHOLE_PASSWORD=
ADMIN_PIN=
# Mindestens 32 zufaellige Zeichen, unabhaengig von ADMIN_PIN.
# Beispiel zur Erzeugung: openssl rand -hex 32
SECRET_KEY=
APP_PORT=8095
IMAGE_TAG=latest
# Fuer Bestandsdaten: absoluter alter Hostpfad, z.B. /srv/peedhcp/data.
# Leer/ausgelassen = neues stackbezogenes Docker-Volume.
DATA_SOURCE=
LOG_LEVEL=INFO
PIHOLE_TLS_INSECURE=false
# Nur mit zusaetzlichem read-only CA-Mount verwenden:
PIHOLE_CA_BUNDLE=
# false erhaelt die bisherige oeffentliche Leseansicht im LAN.
REQUIRE_READ_AUTH=false
